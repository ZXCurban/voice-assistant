# Alembic revisions ARE tracked (backend/alembic/versions/*.py): a fresh
# clone must run `alembic upgrade head` with zero local generation.

# NLU weights are committed split into <100 MB parts (models/nlu/**/model.safetensors.partNN);
# the joined file is built on first start (python -m app.nlu.weights models/nlu).
models/**/model.safetensors
models/**/model.safetensors.tmp

