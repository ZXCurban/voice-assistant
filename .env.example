# Copy to .env and adjust for local development.
APP_NAME=hackathon-skeleton
APP_ENV=local
APP_DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

# Local LLM (any OpenAI-compatible HTTP: llama-server, vLLM, Ollama...).
# Swap models via these vars only — prompts/tools move unchanged. No secrets here.
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=clinic-assistant
LLM_TIMEOUT_S=300.0
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
# Payload dialect (only "openai-compatible" implemented).
LLM_PROVIDER=openai-compatible
# Hybrid reasoning models (Qwen3): false sends enable_thinking=false so the
# reply lands in `content`; true omits the flag. Other models ignore it.
LLM_ENABLE_THINKING=false
LLM_TOOL_CHOICE=auto

# Local NLU (ml-training: ruBERT intent + rut5 slots) + dialogue manager
# instead of the rule-based pipeline. Needs the `nlu` extra
# (pip install ".[nlu]") and the trained weights; see README «Local NLU».
NLU_ENABLED=false
# ml-training `artifacts/` directory (intent/pytorch, slots/pytorch, intent/calibration.json).
NLU_MODEL_DIR=models/nlu
# Overrides the calibrated confidence threshold (default: intent/calibration.json).
# NLU_MIN_CONFIDENCE=0.95
# true: turns the NLU cannot understand go to the rule-based pipeline.
NLU_RULES_FALLBACK=true

# Assistant dialogue logging (dataset / NLU fine-tuning source).
# Records always go to structured logs (logger "assistant.dialogue", one JSON
# object per turn). Set a path to additionally append them to a JSONL file,
# then export a training dataset offline (no HTTP endpoint by design):
#   python scripts/export_dialogue_logs.py --input var/assistant_dialogues.jsonl --output data/nlu_dataset.jsonl
# ASSISTANT_DIALOG_LOGGING_ENABLED=true
# ASSISTANT_DIALOG_LOG_PATH=./var/assistant_dialogues.jsonl
