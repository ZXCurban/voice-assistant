# Copy to .env and adjust for local development.
APP_NAME=hackathon-skeleton
APP_ENV=local
APP_DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

# Local LLM (llama-server, OpenAI-compatible HTTP). No secrets here.
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=clinic-assistant
LLM_TIMEOUT_S=120.0
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
