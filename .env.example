# Copy to .env and adjust for local development.
APP_NAME=hackathon-skeleton
APP_ENV=local
APP_DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

# Local LLM (any OpenAI-compatible HTTP: llama-server, vLLM, Ollama...).
# Swap models via these vars only — prompts/tools move unchanged. No secrets here.
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=clinic-assistant
LLM_TIMEOUT_S=300.0
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1
# Payload dialect (only "openai-compatible" implemented).
LLM_PROVIDER=openai-compatible
# Hybrid reasoning models (Qwen3): false sends enable_thinking=false so the
# reply lands in `content`; true omits the flag. Other models ignore it.
LLM_ENABLE_THINKING=false
LLM_TOOL_CHOICE=auto
